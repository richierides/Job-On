{
  "expo": {
    "name": "Hometaking",
    "slug": "home-diy-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "homediytracker",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.richardkelly.hometaking",
      "infoPlist": {
        "NSCameraUsageDescription": "Hometaking uses the camera to scan your room and capture room photos.",
        "NSMicrophoneUsageDescription": "Hometaking needs microphone access to capture audio descriptions of your tasks."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2D8CFF",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.richardkelly.hometaking",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2D8CFF",
          "dark": {
            "backgroundColor": "#121820"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Hometaking uses the camera to scan your room and capture room photos.",
          "microphonePermission": "Hometaking needs microphone access to capture audio descriptions of your tasks.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hometaking uses your chosen photos to build your room inspiration board."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      "./plugins/with-roomplan-build"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
