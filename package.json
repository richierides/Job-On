{
  "name": "my-app",
  "main": "client/index.js",
  "version": "1.0.0",
  "scripts": {
    "expo:dev": "npx expo start",
    "expo:dev:localhost": "EXPO_PUBLIC_API_URL=http://localhost:5000 npx expo start --localhost",
    "server:dev": "NODE_ENV=development tsx server/index.ts",
    "expo:start:static:build": "npx expo start --no-dev --minify --localhost",
    "expo:static:build": "node scripts/build.js",
    "server:build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=server_dist",
    "server:prod": "NODE_ENV=production node server_dist/index.js",
    "db:push": "drizzle-kit push",
    "lint": "npx expo lint",
    "lint:fix": "npx expo lint --fix",
    "check:types": "tsc --noEmit",
    "check:format": "prettier --check \"**/*.{js,ts,tsx,css,json}\"",
    "format": "prettier --write \"**/*.{js,ts,tsx,css,json}\"",
    "test:rooms": "node --import tsx --test tests/hometaking-model.test.ts tests/hometaking-capture.test.ts tests/hometaking-integration.test.ts",
    "preview:hometaking": "tsx server/hometaking/preview.ts",
    "ios:device": "expo run:ios --device",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "dev:hometaking-api": "node --env-file=.env --import tsx server/hometaking/api.ts",
    "ios:standalone": "bash scripts/ios/build-standalone.sh"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@supabase/supabase-js": "2.57.4",
    "@tanstack/react-query": "^5.90.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^2.0.0",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.1",
    "expo": "^54.0.23",
    "expo-apple-authentication": "^8.0.8",
    "expo-auth-session": "^7.0.10",
    "expo-av": "^16.0.8",
    "expo-blur": "^15.0.7",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "^17.0.10",
    "expo-clipboard": "^8.0.8",
    "expo-constants": "~18.0.9",
    "expo-crypto": "^15.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "^19.0.21",
    "expo-font": "~14.0.9",
    "expo-glass-effect": "~0.1.6",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.10",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.8",
    "expo-modules-core": "~3.0.30",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.8",
    "expo-video": "^3.0.15",
    "expo-video-thumbnails": "^10.0.8",
    "expo-web-browser": "~15.0.9",
    "express": "^5.0.1",
    "form-data": "^4.0.5",
    "http-proxy-middleware": "^3.0.5",
    "multer": "^2.0.2",
    "openai": "^6.16.0",
    "p-limit": "^7.2.0",
    "p-retry": "^7.1.1",
    "pg": "^8.16.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "three": "^0.186.0",
    "tsx": "^4.20.6",
    "uuid": "^13.0.0",
